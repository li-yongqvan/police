# =============================================================================
# AI Forum - Environment Variables Template
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# =============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=ai_forum
POSTGRES_USER=ai_forum
POSTGRES_PASSWORD=ai_forum_dev

# ─── Database Connection (services) ───────────────────────────────────────────
# Each service uses its own schema: schema_auth, schema_forum, schema_admin
# DB_SCHEMA is set per-service in docker-compose.yml
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_forum
DB_USER=ai_forum
DB_PASSWORD=ai_forum_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-strong-random-string
JWT_EXPIRY=30m

# ─── Service URLs (internal communication) ────────────────────────────────────
ADMIN_SERVICE_URL=http://admin-service:8003
USER_SERVICE_URL=http://user-service:8001
FORUM_SERVICE_URL=http://forum-service:8002

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1

# ─── Runtime profile ───────────────────────────────────────────────────────────
# development | production
APP_ENV=development

# Extra IPs/CIDR for demo-login when APP_ENV=production (comma-separated)
DEMO_LOGIN_ALLOWLIST=

# Comma-separated invite codes that can be reused, for demo or pilot testing.
# Leave empty in production unless a reusable invite code is intentional.
REUSABLE_INVITE_CODES=
