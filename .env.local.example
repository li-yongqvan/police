# Local development (Go services on host, infra in Docker)
#   cp .env.local.example .env
#   docker compose -f infra/docker-compose.yml up -d

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ai_forum
DB_USER=ai_forum
DB_PASSWORD=ai_forum_dev

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRY=30m

# QQ Connect OAuth (website app)
# Register an app at https://connect.qq.com/ and set the callback URL to QQ_REDIRECT_URI.
QQ_APP_ID=
QQ_APP_KEY=
QQ_REDIRECT_URI=http://127.0.0.1:8001/api/v1/auth/qq/callback
# Where user-service redirects to after QQ OAuth succeeds (frontend route)
FRONTEND_OAUTH_REDIRECT_URL=http://127.0.0.1:8091/oauth/qq
# If set to 1, new QQ users are rejected (invite-only mode)
QQ_OAUTH_REQUIRE_INVITE=0

ADMIN_SERVICE_URL=http://127.0.0.1:8003
USER_SERVICE_URL=http://127.0.0.1:8001
FORUM_SERVICE_URL=http://127.0.0.1:8002

VITE_API_BASE_URL=/api/v1

APP_ENV=development
DEMO_LOGIN_ALLOWLIST=
