# Production template for Ubuntu cloud (single-host Docker Compose)
#   cp .env.production.example .env

APP_ENV=production

POSTGRES_DB=ai_forum
POSTGRES_USER=ai_forum
POSTGRES_PASSWORD=replace-with-strong-password

DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_forum
DB_USER=ai_forum
DB_PASSWORD=replace-with-strong-password

REDIS_HOST=redis
REDIS_PORT=6379

# Generate: openssl rand -hex 32  (then: bash scripts/check-production-secrets.sh .env)
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_EXPIRY=30m

# Optional: production smoke cron (copy to /opt/ai-forum/.env.smoke)
# BASE_URL=https://api.shgenren.dpdns.org

ADMIN_SERVICE_URL=http://admin-service:8003
USER_SERVICE_URL=http://user-service:8001
FORUM_SERVICE_URL=http://forum-service:8002

# Comma-separated extra IPs/CIDR allowed for demo-login (optional)
# Example: DEMO_LOGIN_ALLOWLIST=203.0.113.10,10.0.0.0/8
DEMO_LOGIN_ALLOWLIST=

VITE_API_BASE_URL=/api/v1
